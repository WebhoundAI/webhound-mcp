{
  "name": "webhound-mcp",
  "version": "0.5.2",
  "mcpName": "ai.webhound/webhound",
  "description": "Run budgeted reports and datasets with Hound, Webhound's DeepSeek V4 Pro + GPT-5.4 research harness, and return inspectable cited evidence.",
  "bin": {
    "webhound-mcp": "dist/webhound-mcp.mjs"
  },
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "files": [
    "bin/",
    "core/",
    "dist/",
    "README.md",
    "canonical-runtime.json",
    "npm-shrinkwrap.json"
  ],
  "scripts": {
    "build": "node scripts/build-package.mjs",
    "self-test": "npm run build && node dist/webhound-mcp.mjs --self-test",
    "mcp:self-test": "npm run self-test",
    "test": "node --test tests/*.test.mjs",
    "audit:prod": "npm audit --omit=dev --audit-level=moderate",
    "parity:check": "node scripts/check-runtime-manifest.mjs",
    "parity:compare": "node scripts/compare-runtime.mjs",
    "package:check": "node scripts/verify-package.mjs",
    "consumer:check": "node scripts/verify-consumer.mjs",
    "release:check": "npm run self-test && npm test && npm run audit:prod && npm run parity:check && npm run package:check && npm run consumer:check",
    "prepublishOnly": "npm run release:check"
  },
  "dependencies": {},
  "devDependencies": {
    "@modelcontextprotocol/sdk": "1.29.0",
    "esbuild": "0.28.1",
    "zod": "3.25.76"
  },
  "overrides": {
    "@hono/node-server": "2.0.11",
    "body-parser": "2.3.0",
    "fast-uri": "3.1.4",
    "hono": "4.12.31"
  },
  "keywords": [
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "agent",
    "agent-skills",
    "research",
    "web-research",
    "research-agent",
    "webhound",
    "claude",
    "cursor",
    "codex"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/WebhoundAI/webhound-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/WebhoundAI/webhound-mcp/issues"
  },
  "homepage": "https://www.webhound.ai/mcp-setup"
}
