{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "ai.webhound/webhound",
  "title": "Webhound",
  "description": "Budgeted web research and datasets with cited outputs, evidence packs, and controllable effort.",
  "version": "0.4.2",
  "websiteUrl": "https://www.webhound.ai",
  "icons": [
    {
      "src": "https://www.webhound.ai/icon.png",
      "mimeType": "image/png"
    }
  ],
  "remotes": [
    {
      "type": "streamable-http",
      "url": "https://api.webhound.ai/api/v2/mcp"
    }
  ],
  "packages": [
    {
      "registryType": "npm",
      "identifier": "webhound-mcp",
      "version": "0.4.2",
      "runtimeHint": "npx",
      "transport": {
        "type": "stdio"
      },
      "environmentVariables": [
        {
          "name": "WEBHOUND_KEY",
          "description": "Your Webhound API key",
          "isRequired": true,
          "isSecret": true,
          "format": "string"
        }
      ]
    }
  ]
}
